{
  "name": "crm",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vibase": "node scripts/vibase.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:migrate": "pnpm -C packages/db db:migrate",
    "db:test:reset": "pnpm -C packages/db db:test:reset",
    "db:test:worktree": "pnpm -C packages/db db:test:worktree",
    "db:codegen": "pnpm -C packages/db db:codegen"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.3"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
