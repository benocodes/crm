{
  "name": "crm",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "changeset": "changeset",
    "vibase": "node scripts/vibase.mjs",
    "orchestrator": "bash scripts/launch-orchestrator.sh",
    "release:build": "pnpm -C packages/release release:build",
    "release:check": "pnpm -C packages/release release:check",
    "release:ci": "pnpm -C packages/release release:ci",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:migrate": "pnpm -C packages/db db:migrate",
    "db:test:reset": "pnpm -C packages/db db:test:reset",
    "db:test:worktree": "pnpm -C packages/db db:test:worktree",
    "db:codegen": "pnpm -C packages/db db:codegen"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "vitest": "5.0.3"
  }
}
