#!/usr/bin/env bash
# Run `gh` as the zooidbot identity. Reads ZB_GH_TOKEN from the environment, or from the
# gitignored .env of this checkout, falling back to the main checkout's .env when run from a
# git worktree (worktrees don't get a copy). Never prints the token or accepts it as an argument.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_files=("$repo_root/.env")
# The main checkout: the parent of the shared .git directory, the same for every worktree.
if common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  main_root="$(dirname -- "$common_dir")"
  [[ "$main_root" != "$repo_root" ]] && env_files+=("$main_root/.env")
fi

token="${ZB_GH_TOKEN:-}"
for env_file in "${env_files[@]}"; do
  [[ -n "$token" ]] && break
  [[ -r "$env_file" ]] || continue
  token="$(sed -n 's/^ZB_GH_TOKEN=//p' "$env_file" | head -n 1)"
  token="${token%\"}"; token="${token#\"}"; token="${token%\'}"; token="${token#\'}"
done

if [[ -z "$token" ]]; then
  echo "gh-zooidbot: ZB_GH_TOKEN is not set and not found in: ${env_files[*]}" >&2
  exit 1
fi

GH_TOKEN="$token" exec gh "$@"
