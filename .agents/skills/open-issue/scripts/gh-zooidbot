#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(git -C "$script_dir" rev-parse --show-toplevel)"
env_file="$repo_root/hq/.env"

if [[ ! -r "$env_file" ]]; then
  echo "gh-zooidbot: cannot read $env_file" >&2
  exit 1
fi

zooidbot_token="$(sed -n 's/^GH_ACCESS_TOKEN=//p' "$env_file" | head -n 1)"
zooidbot_token="${zooidbot_token%\"}"
zooidbot_token="${zooidbot_token#\"}"
zooidbot_token="${zooidbot_token%\'}"
zooidbot_token="${zooidbot_token#\'}"

if [[ -z "$zooidbot_token" ]]; then
  echo "gh-zooidbot: GH_ACCESS_TOKEN is missing from $env_file" >&2
  exit 1
fi

GH_TOKEN="$zooidbot_token" exec gh "$@"
