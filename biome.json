{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.wrangler",
      "!**/coverage",
      "!**/worker-configuration.d.ts",
      "!pnpm-lock.yaml",
      "!.changeset/*.md",
      "!**/*.md",
      "!packages/db/src/generated",
      "!packages/sdk/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noExportsInTest": "off",
        "useIterableCallbackReturn": "off",
        "noImplicitAnyLet": "off",
        "noConfusingVoidType": "warn",
        "noControlCharactersInRegex": "warn",
        "noDuplicateTestHooks": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noShadowRestrictedNames": "warn"
      },
      "complexity": {
        "noCommaOperator": "off",
        "useLiteralKeys": "off",
        "noBannedTypes": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn"
      },
      "correctness": {
        "noUnreachable": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnusedPrivateClassMembers": "warn",
        "noUnusedVariables": "warn",
        "noVoidTypeReturn": "warn",
        "useYield": "warn"
      },
      "performance": {
        "useDomNodeTextContent": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
