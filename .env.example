ZB_GH_TOKEN=

# Database owner: runs migrations and codegen (packages/db). Default: postgresql://localhost/vault_dev
MIGRATION_DATABASE_URL=
# The app role `vault_app` (NOINHERIT, no table privileges until a tenancy wrapper sets a role). Used by the app from CORE12.
DATABASE_URL=
# Database owner for tests: reset script, schema/migration tests, createOwnerTestDb. Default: postgresql://localhost/vault_test
TEST_DATABASE_URL=
# `vault_app` for tests: createTestDb. Default: TEST_DATABASE_URL with user vault_app. `pnpm db:test:worktree` writes both test URLs to packages/db/.env.test.local.
TEST_APP_DATABASE_URL=

# Cloudflare account id for the remote D1 scripts (packages/server-d1 deploy:remote, db:migrate:remote, bootstrap --remote).
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token for the same scripts (permissions: packages/server-d1/README.md, Deploy).
CLOUDFLARE_API_TOKEN=
# Email of the smoked1 instance's owner, passed to the remote bootstrap.
SMOKED1_ADMIN_EMAIL=
# The smoked1 operator agent's API key; written here by `bootstrap --remote --key-env VAULT_SMOKED1_OPERATOR_KEY`, never typed.
# Left commented on purpose: the remote bootstrap refuses to run while the variable is assigned in .env, even empty.
# VAULT_SMOKED1_OPERATOR_KEY=
