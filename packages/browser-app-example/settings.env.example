# Copy to settings.env (gitignored). Environment variables of the same names win over this file.
# The deployment's URL (the API origin), e.g. http://localhost:8787 for `pnpm -C packages/server-d1 dev`.
VIBASE_URL=http://localhost:8787
# The client_id that `oauth_clients.create` answered, registered with the redirect URI http://localhost:5180/callback.
VIBASE_CLIENT_ID=
