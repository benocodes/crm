{
  "name": "@vault/server-postgres",
  "private": true,
  "description": "Enterprise tier (spec CORE36 D22): the Postgres composition of the vault API. The dev server, bootstrap CLI, smokes and golden generator. Open packages never import this one.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "echo \"no tests\"",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/dev-server.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:admin": "tsx scripts/smoke-admin.ts",
    "golden:generate": "tsx scripts/golden.ts generate",
    "golden:check": "tsx scripts/golden.ts check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@vault/api": "workspace:*",
    "@vault/db": "workspace:*",
    "@vault/storage": "workspace:*",
    "@vault/storage-postgres": "workspace:*",
    "jose": "6.2.12",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
