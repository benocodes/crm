{
  "version": 1,
  "define": {
    "projects__c": {
      "label": "Projects",
      "fields": {
        "name": { "kind": "text", "required": true },
        "budget": { "kind": "integer" },
        "stage": { "kind": "enum", "values": ["planned", "active", "done"], "default": "planned" }
      }
    },
    "session_recordings__c": {
      "label": "Session recordings",
      "fields": {
        "title": { "kind": "text", "required": true },
        "length_seconds": { "kind": "integer" }
      }
    }
  },
  "extend": {
    "contacts": {
      "fields": {
        "tier__c": { "kind": "enum", "values": ["bronze", "gold"] },
        "referral_source__c": { "kind": "text" }
      }
    }
  }
}
