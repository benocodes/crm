# Copy to .dev.vars (gitignored by wrangler's convention) and fill in. Never commit real values.
# The signing secret POST /meta/v1/webhooks returned (shown once).
WEBHOOK_SECRET=whsec_replace_me
# An API key of an agent with the scopes listed in the README.
VIBASE_API_KEY=vk_replace_me
# Your vault's origin.
VIBASE_URL=http://127.0.0.1:8787
