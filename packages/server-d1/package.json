{
  "name": "@vibase/server-d1",
  "version": "0.1.0",
  "private": true,
  "description": "Open tier (spec CORE38): Vibase as a Cloudflare module Worker on one D1 database. The Worker entry, its composition, the local D1 bootstrap CLI and wrangler.jsonc.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./compose": "./src/compose.ts",
    "./bootstrap": "./src/bootstrap-d1.ts",
    "./test": "./src/test/kit.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-connect.ts",
    "dev": "pnpm build && wrangler dev --local --port 8787",
    "e2e:connect": "playwright test --config playwright.config.ts connect.e2e.ts",
    "e2e:mcp-oauth": "playwright test --config playwright.config.ts mcp-oauth.e2e.ts",
    "e2e:action-requests": "playwright test --config playwright.config.ts action-requests.e2e.ts",
    "e2e:rail": "tsx scripts/e2e-rail.ts",
    "e2e:gmail-send": "tsx scripts/e2e-gmail-send.ts",
    "e2e:webhook-example": "tsx scripts/e2e-webhook-example.ts",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke:worker": "tsx scripts/smoke-worker.ts",
    "open:check": "tsx scripts/open-check.ts",
    "setup:remote": "tsx scripts/setup-remote.ts",
    "deploy:remote": "tsx scripts/deploy.ts",
    "db:migrate:remote": "tsx scripts/migrate-remote.ts",
    "db:status:remote": "tsx scripts/status-remote.ts",
    "smoke:remote": "tsx scripts/smoke-remote.ts",
    "recordings:pull": "tsx scripts/pull-recordings.ts"
  },
  "dependencies": {
    "@vibase/api": "workspace:*",
    "@vibase/auth": "workspace:*",
    "@vibase/storage": "workspace:*",
    "@vibase/storage-d1": "workspace:*",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.47",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
