{
  "name": "@vibase/server-d1",
  "version": "0.2.1",
  "private": true,
  "description": "Open tier (spec CORE38): Vibase as a Cloudflare module Worker on one D1 database. The Worker entry, its composition, the local D1 bootstrap CLI and wrangler.jsonc.",
  "license": "MIT",
  "type": "module",
  "main": "src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./compose": "./src/compose.ts",
    "./bootstrap": "./src/bootstrap-d1.ts",
    "./test": "./src/test/kit.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-ui.ts && tsx scripts/build-app.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:worker": "pnpm build && wrangler dev --local --port 8787",
    "e2e:mcp-oauth": "playwright test --config playwright.config.ts mcp-oauth.e2e.ts",
    "e2e:action-requests": "playwright test --config playwright.config.ts action-requests.e2e.ts",
    "e2e:agents-clerk": "playwright test --config playwright.config.ts agents-clerk.e2e.ts",
    "e2e:rail": "tsx scripts/e2e-rail.ts",
    "e2e:forms": "tsx scripts/e2e-forms.ts",
    "e2e:gmail-send": "tsx scripts/e2e-gmail-send.ts",
    "e2e:webhook-example": "tsx scripts/e2e-webhook-example.ts",
    "e2e:metadata-scope": "tsx scripts/e2e-metadata-scope.ts",
    "test": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-4} vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "schema:json": "tsx scripts/generate-schema-json.ts",
    "smoke:worker": "tsx scripts/smoke-worker.ts",
    "open:check": "tsx scripts/open-check.ts",
    "setup:remote": "tsx scripts/setup-remote.ts",
    "deploy:remote": "tsx scripts/deploy.ts",
    "auth:migrate:remote": "tsx scripts/auth-migrate-remote.ts",
    "db:migrate:remote": "tsx scripts/migrate-remote.ts",
    "db:status:remote": "tsx scripts/status-remote.ts",
    "smoke:remote": "tsx scripts/smoke-remote.ts",
    "recordings:pull": "tsx scripts/pull-recordings.ts",
    "e2e:auth-pages": "playwright test --config playwright.auth-pages.config.ts auth-pages.e2e.ts",
    "e2e:accounts-connect": "playwright test --config playwright.accounts-connect.config.ts accounts-connect.e2e.ts",
    "e2e:auth-pages-reset": "playwright test --config playwright.auth-pages-reset.config.ts auth-pages-reset.e2e.ts",
    "e2e:oauth-pages": "playwright test --config playwright.oauth-pages.config.ts oauth-pages.e2e.ts",
    "e2e:auth-migration": "playwright test --config playwright.auth-migration.config.ts auth-migration.e2e.ts",
    "e2e:approvals-app": "playwright test --config playwright.approvals-app.config.ts approvals-app.e2e.ts",
    "e2e:browser-app": "playwright test --config playwright.browser-app.config.ts browser-app.e2e.ts"
  },
  "dependencies": {
    "@vibase/api": "workspace:*",
    "@vibase/auth": "workspace:*",
    "@vibase/storage": "workspace:*",
    "@vibase/storage-d1": "workspace:*",
    "kysely": "0.29.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "2.2.47",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vibase/sdk": "workspace:*",
    "@vibase/ui": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "better-auth": "1.7.22",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.68.0",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
