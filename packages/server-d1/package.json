{
  "name": "@vault/server-d1",
  "private": true,
  "description": "Open tier (spec CORE38): the vault as a Cloudflare module Worker on one D1 database. The Worker entry, its composition, the local D1 bootstrap CLI and wrangler.jsonc.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke:worker": "tsx scripts/smoke-worker.ts",
    "open:check": "tsx scripts/open-check.ts"
  },
  "dependencies": {
    "@vault/api": "workspace:*",
    "@vault/storage": "workspace:*",
    "@vault/storage-d1": "workspace:*",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
