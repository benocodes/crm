// The open D1 Worker ([[CORE38]], [[OPS4]]). The top level is local-only: `wrangler dev` and `wrangler d1 migrations apply DB --local`
// run against .wrangler/state, and its database_id is a placeholder that every remote script refuses. A deployed instance is a
// named env below, reached only through `deploy:remote` / `db:migrate:remote` / `bootstrap --remote` (CONFIRM_REMOTE=1).
// There is deliberately no account_id: it comes from CLOUDFLARE_ACCOUNT_ID. A fork replaces the env's names, database_id and
// hostname with its own (see the README's Deploy section). Secrets are never put here: .dev.vars locally, wrangler secret put when deployed.
{
  "name": "vault",
  "main": "src/worker.ts",
  // No nodejs_compat: the app uses Web Crypto only. Keep this date at or below the workerd that Miniflare and wrangler bundle.
  "compatibility_date": "2026-07-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../storage-d1/migrations"
    }
  ],
  // The connect page ([[UI30]] D2): built by `pnpm build` into dist/assets/connect/. The Worker goes first for /connect* only and serves
  // the files itself (adding the security headers); no asset is reachable at any other path. `assets` is inherited by every env.
  "assets": { "directory": "./dist/assets", "binding": "ASSETS", "run_worker_first": ["/connect", "/connect/*"] },
  // Local R2 (no account needed): message bodies and file bytes, served by messages.content and files.content.
  "r2_buckets": [{ "binding": "BODIES", "bucket_name": "vault-bodies" }],
  // The Gmail sync run ([[CHN141]], CHN5 D34): a Workflow whose class `src/worker.ts` exports, and the 15-minute cron that requests syncs. Neither is
  // inherited by an env: each env states its own. They come into being with `deploy:remote`, like a route.
  "workflows": [{ "binding": "MAIL_SYNC", "name": "vault-mail-sync", "class_name": "MailSyncWorkflow" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Secrets (CLERK_JWT_KEY, CLERK_SECRET_KEY) are never put here: .dev.vars locally, wrangler secret put when deployed.
  "vars": {
    "AUTH_PROVIDER": "",
    "CORS_ALLOWED_ORIGINS": ""
  },
  // vars, d1_databases, r2_buckets and routes are not inherited by an env, so each env repeats what it needs (assets is inherited).
  "env": {
    "smoked1": {
      "name": "vault-smoked1",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.smoked1.vibase.ai", "custom_domain": true }],
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vault-smoked1",
          "database_id": "13f7fb64-d909-44e7-9ce7-cc3c753bb3bc",
          "migrations_dir": "../storage-d1/migrations",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "BODIES", "bucket_name": "vault-smoked1-bodies" }],
      "workflows": [{ "binding": "MAIL_SYNC", "name": "vault-smoked1-mail-sync", "class_name": "MailSyncWorkflow" }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": { "AUTH_PROVIDER": "", "CORS_ALLOWED_ORIGINS": "" }
    },
    "hq": {
      "name": "vault-hq",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.hq.vibase.ai",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vault-hq",
          "database_id": "23fda5fd-1508-462a-b700-53ad047472e3",
          "migrations_dir": "../storage-d1/migrations",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "BODIES",
          "bucket_name": "vault-hq-bodies"
        }
      ],
      // The binding and the 15-minute cron ([[CHN5]] D76, D92): the supervised first backfill ran, so the cron renews watches and serves missed pushes. It takes
      // effect only when the user deploys (a hard stop for agents).
      "workflows": [{ "binding": "MAIL_SYNC", "name": "vault-hq-mail-sync", "class_name": "MailSyncWorkflow" }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "AUTH_PROVIDER": "clerk",
        "CLERK_ISSUER": "https://clerk.hq.vibase.ai",
        "CLERK_AUTHORIZED_PARTIES": "https://api.hq.vibase.ai",
        "AUTH_CLI_CLIENT_ID": "Q5yzkwhHy7dhaYbt",
        "CORS_ALLOWED_ORIGINS": "",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaHEudmliYXNlLmFpJA",
        "GOOGLE_CLIENT_ID": "525762252590-76slg8klsir57t6g22fgt06fpm9iot6l.apps.googleusercontent.com",
        "GMAIL_TOPIC_NAME": "projects/vibase-hq/topics/gmail.watch",
        "GMAIL_PUSH_SUBSCRIPTION": "projects/vibase-hq/subscriptions/gmail.push",
        "GMAIL_PUSH_SERVICE_ACCOUNT": "gmail-push@vibase-hq.iam.gserviceaccount.com",
        "PUBLIC_BASE_URL": "https://api.hq.vibase.ai",
        "CREDENTIALS_KEY_VERSION": "1"
      }
    }
  }
}
