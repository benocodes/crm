// The open D1 Worker ([[CORE38]], [[OPS4]]). The top level is local-only: `wrangler dev` and `wrangler d1 migrations apply DB --local`
// run against .wrangler/state, and its database_id is a placeholder that every remote script refuses. A deployed instance is a
// named env below, reached only through `deploy:remote` / `db:migrate:remote` / `bootstrap --remote` (CONFIRM_REMOTE=1).
// There is deliberately no account_id: it comes from CLOUDFLARE_ACCOUNT_ID. A fork replaces the env's names, database_id and
// hostname with its own (see the README's Deploy section). Secrets are never put here: .dev.vars locally, wrangler secret put when deployed.
{
  "name": "vb",
  "main": "src/worker.ts",
  // nodejs_compat: the built-in auth provider's bundle (Better Auth, [[CORE243]] D2) imports `node:*`. Set here, inherited by every env, and carried into the release package's base config;
  // `smoke:worker` lists the `node:` modules the bundle may import. Keep the date at or below the workerd that Miniflare and wrangler bundle.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vb-crm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../storage-d1/migrations"
    },
    // The control-plane database ([[CORE259]] D1): Better Auth's tables and the control marker, with its own compiled migrations and its own d1_migrations tracker. Local only for now: the smoked1 and hq
    // env blocks bind none (the instance tooling creates and binds theirs, [[OPS260]]); a Worker in every auth mode (better-auth, clerk, unset) refuses without it ([[CORE326]]), and the remote scripts refuse an env that binds none until `setup:remote` has added one. Its own placeholder
    // database_id (local wrangler and Miniflare key the SQLite file by it, so the same id would make DB and CONTROL_DB one database); every remote script refuses both.
    {
      "binding": "CONTROL_DB",
      "database_name": "vb-control",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../storage-d1/control-migrations"
    }
  ],
  // The Worker serves the built pages itself (adding the security headers) and goes first for the listed paths only; no asset is reachable at any other path. `assets` is inherited by every env.
  // [[UI504]] D3, D4: both bundles' static files are served at `/assets/<bundle>/<file>` (`/assets/*`) and nowhere else; `/ui/*` is no longer listed.
  // [[UI510]] D4: every page is `/app/<page>` (the app's three and the auth pages' five, `PAGE_TABLE`); the Worker goes first for `/`, `/app`, `/app/*` and `/assets/*` and nothing else. The old page paths and `/connect` are not listed (they 404 through the router). The list is `APP_RUN_WORKER_FIRST`.
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/app", "/app/*", "/assets/*"]
  },
  // Local R2 (no account needed): message bodies and file bytes, served by messages.content and files.content.
  "r2_buckets": [{ "binding": "BODIES", "bucket_name": "vb-bodies" }],
  // The Gmail sync run ([[CHN141]], CHN5 D34): a Workflow whose class `src/worker.ts` exports, and the 15-minute cron that requests syncs. Neither is
  // inherited by an env: each env states its own. They come into being with `deploy:remote`, like a route.
  "workflows": [{ "binding": "MAIL_SYNC", "name": "vb-mail-sync", "class_name": "MailSyncWorkflow" }],
  // The second cron ([[AGT8]] D54) is the execution rail: the expiry sweep and the runner sweep, every minute. The first keeps the Gmail tick on its own cadence.
  "triggers": { "crons": ["*/15 * * * *", "* * * * *"] },
  // Secrets (CLERK_JWT_KEY, CLERK_SECRET_KEY) are never put here: .dev.vars locally, wrangler secret put when deployed.
  "vars": {
    "AUTH_PROVIDER": "",
    "CORS_ALLOWED_ORIGINS": ""
  },
  // The public form route's rate limits ([[CHN432]] D7): `POST /f/<public_id>` counts a request per IP and form (10 a minute) and per form (60 a minute) before any database read. They are Worker config, not account
  // resources. `ratelimits` is not inherited by an env, so each env states its own, with namespace ids of its own (bindings sharing an id share counters across Workers). Needs wrangler 4.36 or later.
  "ratelimits": [
    { "name": "FORM_IP_LIMITER", "namespace_id": "432001", "simple": { "limit": 10, "period": 60 } },
    { "name": "FORM_LIMITER", "namespace_id": "432002", "simple": { "limit": 60, "period": 60 } }
  ],
  // vars, d1_databases, r2_buckets, ratelimits and routes are not inherited by an env, so each env repeats what it needs (assets is inherited).
  "env": {
    "smoked1": {
      "name": "vb-smoked1",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.smoked1.vibase.ai",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vb-crm-smoked1",
          "database_id": "d9b77220-95e6-4443-ad0b-b023937379df",
          "migrations_dir": "../storage-d1/migrations",
          "remote": true
        },
        {
          "binding": "CONTROL_DB",
          "database_name": "vb-control-smoked1",
          "database_id": "cab3ca50-7333-44f2-9de6-9c1e49b47556",
          "migrations_dir": "../storage-d1/control-migrations",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "BODIES",
          "bucket_name": "vb-bodies-smoked1"
        }
      ],
      "ratelimits": [
        { "name": "FORM_IP_LIMITER", "namespace_id": "432003", "simple": { "limit": 10, "period": 60 } },
        { "name": "FORM_LIMITER", "namespace_id": "432004", "simple": { "limit": 60, "period": 60 } }
      ],
      "workflows": [
        {
          "binding": "MAIL_SYNC",
          "name": "vb-mail-sync-smoked1",
          "class_name": "MailSyncWorkflow"
        }
      ],
      "vars": {
        "AUTH_PROVIDER": "better-auth",
        "PUBLIC_BASE_URL": "https://api.smoked1.vibase.ai",
        "CORS_ALLOWED_ORIGINS": ""
      }
    },
    "hq": {
      "name": "vault-hq",
      // Smart Placement (OPS252): run the Worker near its D1 databases (WEUR), not near each caller; a connector's discovery check from the US was taking 2-3 s.
      "placement": { "mode": "smart" },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.hq.vibase.ai",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vault-hq",
          "database_id": "23fda5fd-1508-462a-b700-53ad047472e3",
          "migrations_dir": "../storage-d1/migrations",
          "remote": true
        },
        {
          "binding": "CONTROL_DB",
          "database_name": "vb-control-hq",
          "database_id": "c3b621e9-0da4-4dca-acdb-5c02d82729db",
          "migrations_dir": "../storage-d1/control-migrations",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "BODIES",
          "bucket_name": "vault-hq-bodies"
        }
      ],
      // [[CHN432]] D7: the form route's ratelimits bindings (namespace ids of their own); they take effect only when the user deploys `hq` (a hard stop for agents).
      "ratelimits": [
        { "name": "FORM_IP_LIMITER", "namespace_id": "432005", "simple": { "limit": 10, "period": 60 } },
        { "name": "FORM_LIMITER", "namespace_id": "432006", "simple": { "limit": 60, "period": 60 } }
      ],
      // The binding and the 15-minute cron ([[CHN5]] D76, D92): the supervised first backfill ran, so the cron renews watches and serves missed pushes. It takes
      // effect only when the user deploys (a hard stop for agents).
      // [[AGT8]] D54: and the per-minute cron of the execution rail; it registers only when the user next deploys `hq`.
      "workflows": [{ "binding": "MAIL_SYNC", "name": "vault-hq-mail-sync", "class_name": "MailSyncWorkflow" }],
      "triggers": { "crons": ["*/15 * * * *", "* * * * *"] },
      "vars": {
        "AUTH_PROVIDER": "better-auth",
        "CLERK_ISSUER": "https://clerk.hq.vibase.ai",
        "CLERK_AUTHORIZED_PARTIES": "https://api.hq.vibase.ai,https://app.hq.vibase.ai",
        // The approvals app (packages/approvals-app) calls this API from the browser; it takes effect when the user next deploys `hq`.
        "CORS_ALLOWED_ORIGINS": "https://app.hq.vibase.ai",
        // [[UI255]] D9: the approvals app is a first-party app of the Better Auth session. Inert while hq runs Clerk (read only for better-auth); it takes effect when the user deploys the cutover ([[OPS252]]).
        "AUTH_TRUSTED_ORIGINS": "https://app.hq.vibase.ai",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaHEudmliYXNlLmFpJA",
        "GOOGLE_CLIENT_ID": "525762252590-76slg8klsir57t6g22fgt06fpm9iot6l.apps.googleusercontent.com",
        "GMAIL_TOPIC_NAME": "projects/vibase-hq/topics/gmail.watch",
        "GMAIL_PUSH_SUBSCRIPTION": "projects/vibase-hq/subscriptions/gmail.push",
        "GMAIL_PUSH_SERVICE_ACCOUNT": "gmail-push@vibase-hq.iam.gserviceaccount.com",
        "PUBLIC_BASE_URL": "https://api.hq.vibase.ai",
        "CREDENTIALS_KEY_VERSION": "1"
      }
    }
  }
}
