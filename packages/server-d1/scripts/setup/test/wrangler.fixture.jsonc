// TEST FIXTURE, not the deploy config. The setup tests read this literal copy of the repo's wrangler.jsonc shape (top level plus
// env.smoked1 with its fixed values) so that a real env block (hq, a fork's own) committed to wrangler.jsonc can never become a
// test input. Do not point a test at ../../../wrangler.jsonc; the guard in config-fixture.test.ts fails if one does.
// The open D1 Worker ([[CORE38]], [[OPS4]]). The top level is local-only: `wrangler dev` and `wrangler d1 migrations apply DB --local`
// run against .wrangler/state, and its database_id is a placeholder that every remote script refuses. A deployed instance is a
// named env below, reached only through `deploy:remote` / `db:migrate:remote` / `bootstrap --remote` (CONFIRM_REMOTE=1).
// There is deliberately no account_id: it comes from CLOUDFLARE_ACCOUNT_ID. A fork replaces the env's names, database_id and
// hostname with its own (see the README's Deploy section). Secrets are never put here: .dev.vars locally, wrangler secret put when deployed.
{
  "name": "vault",
  "main": "src/worker.ts",
  // nodejs_compat: the built-in auth provider's bundle (Better Auth, [[CORE243]] D2) imports `node:*`. Set here, inherited by every env, and carried into the release package's base config;
  // `smoke:worker` lists the `node:` modules the bundle may import. Keep the date at or below the workerd that Miniflare and wrangler bundle.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../storage-d1/migrations"
    }
  ],
  // The connect page ([[UI30]] D2): built by `pnpm build` into dist/assets/connect/. The Worker goes first for /connect* only and serves
  // the files itself (adding the security headers); no asset is reachable at any other path. `assets` is inherited by every env.
  "assets": { "directory": "./dist/assets", "binding": "ASSETS", "run_worker_first": ["/connect", "/connect/*"] },
  // Local R2 (no account needed): message bodies and file bytes, served by messages.content and files.content.
  "r2_buckets": [{ "binding": "BODIES", "bucket_name": "vault-bodies" }],
  // Secrets (CLERK_JWT_KEY, CLERK_SECRET_KEY) are never put here: .dev.vars locally, wrangler secret put when deployed.
  "vars": {
    "AUTH_PROVIDER": "",
    "CORS_ALLOWED_ORIGINS": ""
  },
  // vars, d1_databases, r2_buckets and routes are not inherited by an env, so each env repeats what it needs (assets is inherited).
  "env": {
    "smoked1": {
      "name": "vault-smoked1",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.smoked1.vibase.ai", "custom_domain": true }],
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vault-smoked1",
          "database_id": "13f7fb64-d909-44e7-9ce7-cc3c753bb3bc",
          "migrations_dir": "../storage-d1/migrations",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "BODIES", "bucket_name": "vault-smoked1-bodies" }],
      "vars": { "AUTH_PROVIDER": "", "CORS_ALLOWED_ORIGINS": "" }
    }
  }
}
