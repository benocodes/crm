# Copy to .dev.vars (gitignored) for `wrangler dev`. Leave AUTH_PROVIDER empty (in wrangler.jsonc) for an agent-only deployment.
# With AUTH_PROVIDER=clerk all of these are required; CLERK_API_URL is optional.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_API_URL=
