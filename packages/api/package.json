{
  "name": "@vibase/api",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test/golden": "./src/test/golden/index.ts",
    "./test/clerk": "./src/test/clerk.ts",
    "./test/better-auth": "./src/test/better-auth.ts",
    "./test/messaging": "./src/test/messaging-kit.ts",
    "./test/capture": "./src/test/capture-kit.ts",
    "./test/objects": "./src/test/objects.ts",
    "./test/channels": "./src/test/channels.ts",
    "./test/gmail": "./src/test/gmail.ts",
    "./test/gmail-sync": "./src/test/gmail-sync.ts",
    "./test/google": "./src/test/google.ts",
    "./test/push": "./src/test/push.ts",
    "./test/gmail-fixtures": "./src/test/gmail-fixtures.ts",
    "./test/streams": "./src/test/streams.ts",
    "./test/workerd-boundary": "./src/test/workerd-boundary.ts",
    "./test/rail": "./src/test/rail-kit.ts"
  },
  "//": "test: 4 is the default file parallelism, chosen by measurement (OPS223 D4); on a loaded machine run VITEST_MAX_WORKERS=N pnpm test with a lower N and name N in RESULT.md (vitest rejects a second --maxWorkers flag). Postgres stays serial (vitest.projects.ts).",
  "scripts": {
    "test": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-4} vitest run --config ../../vitest.config.ts",
    "test:postgres": "vitest run --config ../../vitest.postgres.config.ts",
    "typecheck": "tsc --noEmit",
    "golden:generate": "tsx scripts/golden.ts generate",
    "golden:check": "tsx scripts/golden.ts check",
    "recordings:generate": "tsx scripts/google-recordings.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@vibase/storage": "workspace:*",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-mdast": "10.1.2",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^22",
    "@vibase/db": "workspace:*",
    "@vibase/storage-d1": "workspace:*",
    "@vibase/storage-postgres": "workspace:*",
    "chat": "4.43.0",
    "standardwebhooks": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
